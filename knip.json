{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "scripts/*.ts",
    "test/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**",
    "test/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@earendil-works/pi-ai",
    "@earendil-works/pi-tui",
    "typebox",
    "jscpd"
  ],
  "ignoreBinaries": [
    "java"
  ]
}

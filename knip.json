{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "scripts/*.ts",
    "test/**/*.test.ts",
    "test/**/*.test.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**",
    "test/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "java"
  ]
}
